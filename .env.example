# Variables d'environnement du kit. Ne jamais committer de valeurs réelles :
# les renseigner dans n8n (workflows) et dans Vercel (pages de suivi).

# Supabase
SUPABASE_URL=https://votre-projet.supabase.co
# Clé service_role : n8n uniquement, jamais dans une page web ni dans Vercel
SUPABASE_SERVICE_KEY=
# Clé publique "anon" (ou publishable) : Vercel, écrite dans config.js au build
SUPABASE_ANON_KEY=

# Modèle de langage (chatbot et prospection)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# WhatsApp Cloud API (Meta)
WA_VERIFY_TOKEN=
WA_TOKEN=
WA_TEMPLATE_TRACKING=suivi_colis

# Webhook Supabase vers n8n (en-tête x-webhook-secret)
WEBHOOK_SECRET=

# Adresse publique de la page de suivi (n8n et Vercel)
TRACKING_BASE_URL=https://votre-domaine/suivi-colis/suivi.html

# Expéditeur des emails de prospection
SMTP_FROM=
